---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import logo from '../assets/site/logo.png';
import hero from '../assets/site/hero-lava.jpg';
import builderShot from '../assets/site/army-builder.jpg';
import chargeShot from '../assets/site/flank-charge.jpg';
import { accentColor, FACTIONS, slug, heroUnit, portrait } from '../lib/factions';
import { ARMY_BUILDER_URL, STEAM_URL, url } from '../lib/site';
---
<Base title="SOVL Rules" description="The rules of SOVL: Fantasy Warfare. Learn to play in five minutes, look up any rule, and browse every faction's army list.">
  <section class="home-hero">
    <Image class="home-hero-bg" src={hero} alt="" widths={[960, 1600, 2400]} sizes="100vw" loading="eager" />
    <div class="home-hero-inner">
      <Image class="home-logo" src={logo} alt="SOVL: Fantasy Warfare" width={560} widths={[320, 560, 1000]} sizes="(max-width: 640px) 80vw, 560px" loading="eager" />
      <p class="home-tagline">Every rule of the battlefield, explained.</p>
      <p class="home-sub">Regiments, monsters and heroes. Charges, flanks and broken nerve. Learn how a battle works in five minutes, then look up any rule as you play.</p>
      <div class="home-cta">
        <a class="btn btn-gold" href={url('/rules/')}>Learn to play</a>
        <a class="btn" href={ARMY_BUILDER_URL}>Open the Army Builder</a>
      </div>
    </div>
  </section>

  <section class="home-paths">
    <a class="path-card" href={url('/rules/')}>
      <span class="path-num">5 minutes</span>
      <span class="path-title">How a Battle Works</span>
      <span class="path-text">Armies, the battlefield, the three phases of a turn, dice and winning. Start here.</span>
    </a>
    <a class="path-card" href={url('/rules/units/')}>
      <span class="path-num">The rules</span>
      <span class="path-title">Every rule, explained</span>
      <span class="path-text">Units, terrain, charges, shooting, magic and melee, with diagrams and worked examples.</span>
    </a>
    <a class="path-card" href={url('/reference/')}>
      <span class="path-num">At the table</span>
      <span class="path-title">Quick Reference</span>
      <span class="path-text">To-hit, saves, combat score and break tests on one page. Keep it open while you play.</span>
    </a>
  </section>

  <section class="home-feature">
    <div class="home-feature-text">
      <p class="eyebrow">How SOVL plays</p>
      <h2>Charge first, think always</h2>
      <p>Every turn opens with charges, before anyone moves. Where you leave a unit at the end of a turn decides who can hit whom at the start of the next. Catch an enemy in the flank and their ranks count for nothing. Get caught yourself and your best regiment runs.</p>
      <p>Players take turns unit by unit, so every move answers your opponent's last one.</p>
      <a class="btn" href={url('/rules/charge-phase/')}>Read the Charge rules</a>
    </div>
    <Image class="home-feature-shot" src={chargeShot} alt="Knights crash into the flank of an Orc regiment, with the attack roll panel open." width={900} widths={[480, 900]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" />
  </section>

  {FACTIONS.length > 0 && (
    <section class="home-factions">
      <div class="home-section-head">
        <p class="eyebrow">Armies</p>
        <h2>{FACTIONS.length} factions</h2>
        <p>Every faction's full army list: stats, points, options and portraits, straight from the game.</p>
      </div>
      <div class="faction-strip">
        {FACTIONS.map((f) => {
          const u = heroUnit(f);
          const img = portrait(u?.image);
          return (
            <a class="strip-card" href={url(`/armies/${slug(f.id)}/`)} style={`--accent:${accentColor(f)}`}>
              {img && <Image src={img} alt="" width={220} widths={[160, 220]} sizes="160px" loading="lazy" />}
              <span>{f.name}</span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="home-builder">
    <Image class="home-builder-shot" src={builderShot} alt="The SOVL Army Builder with a Knights of Avalon army." width={900} widths={[480, 900]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" />
    <div>
      <p class="eyebrow">Army Builder</p>
      <h2>Build your army in the browser</h2>
      <p>The same Army Builder as in the game, running on the web. Every faction is available, and your lists are saved in your browser. Phones and tablets get their own layout.</p>
      <div class="home-cta">
        <a class="btn btn-gold" href={ARMY_BUILDER_URL}>Open the Army Builder</a>
        <a class="btn" href={STEAM_URL}>Get SOVL on Steam</a>
      </div>
    </div>
  </section>
</Base>
