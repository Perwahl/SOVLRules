---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
  /** Crop as fractions of the source image: [x, y, w, h]. */
  narrow?: boolean;
}
const { src, alt, caption, width = 1400, narrow = false } = Astro.props;
---
<figure class:list={['figure', { narrow }]}>
  <Image src={src} alt={alt} width={width} widths={[640, 960, width]} sizes="(max-width: 900px) 100vw, 46rem" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
