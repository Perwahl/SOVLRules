---
import Diagram from './Diagram.astro';
import Unit from './Unit.astro';

// Charger: Infantry, 5 wide, 4 deep, Move 8". Front edge at y = 17.
const w = 5 * 0.79;
const cx = 18;
const fy = 17;
const L = cx - w / 2;
const R = cx + w / 2;
const reach = 8;
const k = reach * Math.SQRT1_2;
const sight = `M ${L} ${fy} L ${L - k} ${fy - k} A ${reach} ${reach} 0 0 1 ${L} ${fy - reach} L ${R} ${fy - reach} A ${reach} ${reach} 0 0 1 ${R + k} ${fy - k} Z`;
---
<Diagram width={36} height={23} title="Charge reach: a unit can charge enemies within its Move inside a 90 degree arc from its front edge, unless sight is blocked." caption="Charge reach of an Infantry unit with Move 8&quot;. Sight fans out 45° from each front corner and stops at the first unit or sight-blocking terrain.">
  <path class="dg-sight" d={sight} />
  <path class="dg-forest" d="M 20.7 12.2 C 21.6 10.9, 23.6 11.1, 24.0 12.5 C 24.5 14.3, 22.9 15.3, 21.6 14.8 C 20.3 14.4, 20.0 13.1, 20.7 12.2 Z" />
  <text class="dg-note" x="22.3" y="13.5" text-anchor="middle">Forest</text>

  <Unit x={12.6} y={7.6} rot={200} side="enemy" label="Can charge" labelPos="above" />
  <Unit x={18} y={3.2} rot={180} side="enemy" label="Too far" labelPos="right" />
  <Unit x={24.6} y={9.0} rot={205} side="enemy" label="Hidden by forest" labelPos="right" />

  <line class="dg-ray" x1={L + 0.2} y1={fy} x2={13.6} y2={10.1} marker-end="url(#arrow)" />
  <line class="dg-ray dg-ray-bad" x1={R} y1={fy} x2={21.2} y2={14.9} />
  <text class="dg-x" x="21.35" y="15.15" text-anchor="middle">✕</text>

  <Unit x={cx} y={fy + (4 * 0.79) / 2} side="friend" label="Charger · Move 8&quot;" />
</Diagram>
